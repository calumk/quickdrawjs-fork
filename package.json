{
  "name": "@quickdrawjs/core",
  "version": "0.3.0",
  "description": "Framework-free infinite-canvas whiteboard engine — the heart of Quickdraw, the MIT-licensed drawing SDK.",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./quickdraw.css": "./src/quickdraw.css",
    "./styles.css": "./src/quickdraw.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "whiteboard",
    "canvas",
    "drawing",
    "infinite-canvas",
    "sketch",
    "freehand",
    "tldraw-alternative",
    "excalidraw-alternative",
    "diagram"
  ],
  "license": "MIT",
  "homepage": "https://tryquickdraw.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/calumk/quickdrawjs-fork.git"
  },
  "bugs": "https://github.com/calumk/quickdrawjs-fork/issues",
  "publishConfig": {
    "access": "public"
  }
}
